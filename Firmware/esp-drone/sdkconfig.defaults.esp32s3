CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# ESP-FLY (Seeed XIAO ESP32-S3 + ESP-FLY IMU/motor board) board profile,
# carried over from the Co-Create ESP-FLY firmware sdkconfig.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_TARGET_ESP32_S2_DRONE_V1_2=y
CONFIG_WIFI_CHANNEL=1
CONFIG_I2C0_PIN_SDA=5
CONFIG_I2C0_PIN_SCL=6
CONFIG_I2C1_PIN_SDA=40
CONFIG_I2C1_PIN_SCL=41
CONFIG_SPI_PIN_MISO=37
CONFIG_SPI_PIN_MOSI=35
CONFIG_SPI_PIN_CLK=36
CONFIG_SPI_PIN_CS0=34
CONFIG_MPU_PIN_INT=8
CONFIG_ADC1_PIN=10
CONFIG_EXT01_PIN=0
CONFIG_LED_PIN_BLUE=11
CONFIG_LED_PIN_GREEN=9
CONFIG_LED_PIN_RED=43
CONFIG_MOTOR01_PIN=7
CONFIG_MOTOR02_PIN=4
CONFIG_MOTOR03_PIN=3
CONFIG_MOTOR04_PIN=1
CONFIG_BUZ1_PIN_POS=39
CONFIG_BUZ2_PIN_NEG=38
# XIAO ESP32-S3: logs over the native USB port as well as UART0
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Mender OTA: A/B app slots, roll back to the previous firmware if a new one never checks in
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_mender.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MENDER_SERVER_HOST_EU=y
CONFIG_MENDER_DEVICE_TYPE="esp-fly"
# Artifacts are built separately with mender-artifact (see README)
CONFIG_MENDER_ARTIFACT_GENERATE=n
# Spin each motor briefly after calibration, like the original Seeed firmware
CONFIG_MOTORS_STARTUP_TEST=y
# Check Mender for updates every 5 minutes (default is once a week, i.e. only at boot)
CONFIG_MENDER_CLIENT_UPDATE_POLL_INTERVAL=300
